{
  "expo": {
    "name": "GameLeituraEscrita",
    "slug": "gameleituraescrita",
    "scheme": "gameleituraescrita",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devirlabs.gameleituraescrita"
    },
    "android": {
      "package": "com.devirlabs.gameleituraescrita",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-audio", "expo-sqlite", "expo-router", "expo-status-bar"]
  }
}
