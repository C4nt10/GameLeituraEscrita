{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "MODELO_DE_VOZ": "small"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-voz-medium": {
      "distribution": "internal",
      "env": {
        "MODELO_DE_VOZ": "medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
